{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arcadia-de/hypha",
  "title": "Hypha",
  "description": "A hypha manifest schema",
  "type": "object",
  "required": [
    "kind",
    "spec"
  ],
  "allOf": [
    {
      "properties": {
        "version": {
          "$ref": "#/$defs/Version"
        },
        "id": {
          "$ref": "#/$defs/ResourceId"
        },
        "metadata": {
          "$ref": "#/$defs/ResourceMetadata"
        },
        "kind": {
          "enum": [
            "Test",
            "Symlink",
            "Directory",
            "Archive",
            "Task",
            "Template"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Symlink"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/SymlinkSpec"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Directory"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/DirectorySpec"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Archive"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/ArchiveSpec"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Test"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/TestSpec"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Task"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/TaskSpec"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Template"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/TemplateSpec"
          }
        }
      }
    }
  ],
  "$defs": {
    "ResourceId": {
      "type": "string"
    },
    "Version": {
      "type": "string",
      "description": "Semver-formatted version of the manifest format this resource was written against (e.g. '1.0.0'). Optional; omitted manifests are treated as the current supported version.",
      "pattern": "^v?\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "ResourceAnnotation": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "additionalProperties": false
    },
    "ResourceMetadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceAnnotation"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "TestSpec": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "SymlinkSpec": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "additionalProperties": false
    },
    "DirectorySpec": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    },
    "ExecSpec": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "number"
        },
        "shell": {
          "type": "string"
        },
        "command": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "TaskPolicy": {
      "type": "string",
      "enum": [
        "Always",
        "Once",
        "OnChange"
      ]
    },
    "TaskSpec": {
      "type": "object",
      "properties": {
        "policy": {
          "$ref": "#/$defs/TaskPolicy"
        },
        "exec": {
          "$ref": "#/$defs/ExecSpec"
        },
        "check": {
          "$ref": "#/$defs/ExecSpec"
        }
      },
      "required": [
        "exec"
      ],
      "additionalProperties": false
    },
    "TemplateSpec": {
      "type": "object",
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "template"
              ]
            },
            {
              "required": [
                "templateFile"
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "data"
              ]
            },
            {
              "required": [
                "dataFile"
              ]
            }
          ]
        }
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "templateFile": {
          "type": "string"
        },
        "dataFile": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ArchiveSpec": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "dest": {
          "type": "string"
        }
      },
      "required": [
        "dest",
        "source"
      ],
      "additionalProperties": false
    }
  }
}
